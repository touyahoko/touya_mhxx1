<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="護石登録" android:textStyle="bold" android:textSize="16sp" />

    <Spinner android:id="@+id/spTemplate" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <AutoCompleteTextView android:id="@+id/etSkill1Sys" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="2"
            android:hint="系統1" android:completionThreshold="1" />
        <EditText android:id="@+id/etSkill1Val" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="値" android:inputType="numberSigned" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <AutoCompleteTextView android:id="@+id/etSkill2Sys" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="2"
            android:hint="系統2 (任意)" android:completionThreshold="1" />
        <EditText android:id="@+id/etSkill2Val" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="値" android:inputType="numberSigned" />
    </LinearLayout>
    <Spinner android:id="@+id/spSlots" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddCharm"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="護石を登録" android:layout_marginTop="4dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="登録済み護石" android:textStyle="bold" android:layout_marginTop="12dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCharms"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
