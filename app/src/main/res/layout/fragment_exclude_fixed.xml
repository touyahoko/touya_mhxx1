<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbUseExcludeFixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="除外・固定を使う"
        android:checked="true" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="固定装備" android:textStyle="bold" android:layout_marginTop="8dp" />

    <Spinner android:id="@+id/spPart" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <AutoCompleteTextView android:id="@+id/etEquipName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="装備名を入力" android:completionThreshold="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnFix"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="固定" android:layout_marginEnd="4dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnExclude"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="除外" style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="固定中" android:textStyle="bold" android:layout_marginTop="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvFixed"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="除外中" android:textStyle="bold" android:layout_marginTop="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExclude"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnClearAll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="すべてクリア" style="@style/Widget.Material3.Button.TextButton" />
</LinearLayout>
